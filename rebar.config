{erl_opts, [debug_info]}.
{deps, [
    {uuid, "2.0.7", {pkg, uuid_erl}},
    % ZSTD compression support for ClickHouse protocol
    {ezstd, "~> 1.2"}
]}.

{profiles, [
    {test, [
        {deps, [proper, meck]},
        {ct_opts, [
            {dir, "test"},
            {logdir, "_build/test/logs"}
        ]}
    ]},
    {quick_test, [
        {deps, [proper, meck]},
        % Quick checks
        {proper_opts, [{numtests, 10}]}
    ]},
    {full_test, [
        {deps, [proper, meck]},
        % Extensive testing
        {proper_opts, [{numtests, 1000}]}
    ]}
]}.

{shell, [
    %% {config, "config/sys.config"},
    {apps, [clickhouse_erl]}
]}.

{project_plugins, [
    rebar3_lint,
    rebar3_proper,
    pc
]}.

{proper_opts, [
    % Default iterations
    {numtests, 100},
    % Max generator size
    {max_size, 20},
    % Constraint attempts
    {constraint_tries, 50}
]}.

{provider_hooks, [
    {post, [
        {compile, {pc, compile}},
        {clean, {pc, clean}}
    ]}
]}.

{port_specs, [
    {"priv/clickhouse_erl_lz4_nif.so", ["c_src/*.c"]}
]}.

{port_env, [
    {"CFLAGS", "$CFLAGS -O3 -std=c99 -finline-functions -Wall -fPIC"},
    {"LDFLAGS", "$LDFLAGS -llz4"}
]}.
