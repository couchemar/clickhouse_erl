{application, clickhouse_erl, [
    {description, "ClickHouse client"},
    {vsn, "0.5.0"},
    {registered, [clickhouse_erl_sup, clickhouse_erl_connection_sup]},
    {mod, {clickhouse_erl_app, []}},
    {applications, [
        kernel,
        stdlib,
        uuid,
        ezstd
    ]},
    {env, [
        %% Exception parsing limits and safety constants
        {max_exception_nesting_depth, 10},
        % 64KB limit for stack traces
        {max_stack_trace_size, 65536},
        % 8KB limit for exception messages
        {max_exception_message_size, 8192},
        % 1KB limit for exception names
        {max_exception_name_size, 1024},
        % Maximum total memory allocation per exception (1MB)
        {max_total_exception_size, 1048576},
        % Maximum number of nested exceptions
        {max_nested_exception_count, 50}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
